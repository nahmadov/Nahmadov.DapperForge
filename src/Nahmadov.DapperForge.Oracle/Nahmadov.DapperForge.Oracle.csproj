<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Nahmadov.DapperForge.Oracle</PackageId>
    <Title>DapperForge for Oracle</Title>
    <Description>Oracle provider for DapperForge using Dapper and Oracle.ManagedDataAccess.</Description>
    <PackageTags>dapper oracle orm toolkit</PackageTags>
    <PackageReleaseNotes>
Unreleased:
- Core: unified SqlPredicateTranslator; AsSplitQuery Include filter bug fixed.

v2.2.0:
- BulkInsertAsync and BulkMergeAsync (uses Oracle MERGE statement; RowsInserted/RowsUpdated not available natively).
- Include/ThenInclude Where filter support.
    </PackageReleaseNotes>

    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nahmadov.DapperForge.Core\Nahmadov.DapperForge.Core.csproj" />
  </ItemGroup>

</Project>
