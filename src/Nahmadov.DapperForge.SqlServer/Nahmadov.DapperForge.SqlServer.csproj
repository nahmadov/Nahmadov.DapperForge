<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Nahmadov.DapperForge.SqlServer</PackageId>
    <Title>DapperForge for SQL Server</Title>
    <Description>SQL Server provider for DapperForge using Dapper and Microsoft.Data.SqlClient.</Description>
    <PackageTags>dapper sqlserver orm toolkit</PackageTags>
    <PackageReleaseNotes>
v2.5.0:
- GetColumnTypeSql resolves SqlColumnType to concrete SQL Server DDL types (nvarchar(n), decimal(p,s), datetime2, ...).
- Session temp-table DDL: CREATE TABLE #Name (...).
- SqlBulkCopy-backed bulk copy executor for DapperSet.BulkCopyAsync / DapperDbContext.BulkCopyAsync.

v2.2.0:
- BulkInsertAsync and BulkMergeAsync (uses SQL Server MERGE statement).
- Include/ThenInclude Where filter support.
    </PackageReleaseNotes>

    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nahmadov.DapperForge.Core\Nahmadov.DapperForge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nahmadov.DapperForge.UnitTests" />
  </ItemGroup>

</Project>
